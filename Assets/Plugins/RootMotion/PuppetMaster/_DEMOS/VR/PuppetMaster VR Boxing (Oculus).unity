--- !u!114 &248282407
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 248282406}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 92471cc1733c49042be56cd39b4b6e5e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  text: 'The puppet in this scene is just a normal puppet with the exception of having
    the VRPuppet.cs script on it.


    Hand objects follow the VR hand anchors physically
    by using the DynamicAnchor script. This gives you a certain amount of strength
    in VR to push physical objects and puppets as compared to having infinite strength
    if the hand objects were kinematic.'
